# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Option 1: MongoDB Atlas (Cloud)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database_name>?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://admin:yourpassword@cluster0.abcde.mongodb.net/student_db?retryWrites=true&w=majority

# Option 2: Local MongoDB (Default for local testing if MongoDB service is running)
MONGODB_URI=mongodb://127.0.0.1:27017/student_management_db
